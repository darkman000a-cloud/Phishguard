# PhishGuard Enterprise Security Hub — Environment Configuration
# Copy this file to .env.local for local development or set these variables in your deployment dashboard.

# 1. PostgreSQL / Supabase Database Connection
# If unset, PhishGuard automatically falls back to high-performance local resilient storage (data/phishguard_db.json + data/url_events.jsonl).
# For multi-container production deployments (Supabase, Neon, Cloud SQL, AWS RDS), set your connection string:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Alternative Supabase pooled direct connection (Transaction pooler on port 6543)
# SUPABASE_DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# 2. Public Application URL
# Used to dynamically configure downloaded Chrome Extension packages and CORS policies.
# Defaults to request origin or http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# 3. Optional Supabase Client SDK variables
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=your-service-role-key